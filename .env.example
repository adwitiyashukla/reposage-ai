GEMINI_API_KEY=your-key-here

REPOSAGE_FAST_MODEL=gemini-flash-lite-latest
REPOSAGE_DEEP_MODEL=gemini-flash-latest
REPOSAGE_EMBED_MODEL=gemini-embedding-001
REPOSAGE_EMBED_DIMENSIONS=768

REPOSAGE_TOP_K=12
REPOSAGE_CANDIDATE_K=40
REPOSAGE_RRF_K=60
REPOSAGE_ENABLE_RERANK=true

REPOSAGE_MAX_AGENT_STEPS=8
REPOSAGE_MAX_REFINEMENTS=2
REPOSAGE_ENABLE_CRITIC=true

REPOSAGE_MAX_FILE_BYTES=400000
REPOSAGE_MAX_FILES=4000
REPOSAGE_CHUNK_MAX_LINES=120
REPOSAGE_CHUNK_OVERLAP_LINES=15

REPOSAGE_DATA_DIR=.reposage
REPOSAGE_ENABLE_CACHE=true
REPOSAGE_CACHE_TTL_SECONDS=604800
REPOSAGE_MAX_CONCURRENCY=8
REPOSAGE_MAX_RPM=0
REPOSAGE_EMBED_RPM=75
REPOSAGE_EMBED_CONCURRENCY=1
REPOSAGE_LOG_LEVEL=INFO
REPOSAGE_LOG_JSON=false

GITHUB_TOKEN=
