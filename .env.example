# ---------------------------------------------------------------------------
# RepoSage configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- Model selection -------------------------------------------------------
# Fast/cheap model used for planning, reranking and routing.
REPOSAGE_FAST_MODEL=gemini-flash-lite-latest
# Higher-quality model used for analysis, review and synthesis.
REPOSAGE_DEEP_MODEL=gemini-flash-latest
# Embedding model used to index code chunks.
REPOSAGE_EMBED_MODEL=gemini-embedding-001
REPOSAGE_EMBED_DIMENSIONS=768   # 3072 is the default; 768 indexes 4x smaller

# --- Retrieval tuning ------------------------------------------------------
REPOSAGE_TOP_K=12                 # final chunks passed to the analyst
REPOSAGE_CANDIDATE_K=40           # candidates pulled from each retriever
REPOSAGE_RRF_K=60                 # reciprocal rank fusion smoothing constant
REPOSAGE_ENABLE_RERANK=true       # LLM listwise reranking of fused candidates

# --- Agent behaviour -------------------------------------------------------
REPOSAGE_MAX_AGENT_STEPS=8        # hard ceiling on graph iterations
REPOSAGE_MAX_REFINEMENTS=2        # critic-triggered retrieval retries
REPOSAGE_ENABLE_CRITIC=true

# --- Ingestion limits ------------------------------------------------------
REPOSAGE_MAX_FILE_BYTES=400000
REPOSAGE_MAX_FILES=4000
REPOSAGE_CHUNK_MAX_LINES=120
REPOSAGE_CHUNK_OVERLAP_LINES=15

# --- Infrastructure --------------------------------------------------------
REPOSAGE_DATA_DIR=.reposage
REPOSAGE_ENABLE_CACHE=true
REPOSAGE_CACHE_TTL_SECONDS=604800
REPOSAGE_MAX_CONCURRENCY=8         # simultaneous in-flight API requests
REPOSAGE_MAX_RPM=0                 # generation requests/min cap (0 = off)
REPOSAGE_EMBED_RPM=75
REPOSAGE_EMBED_CONCURRENCY=1       # serialised; the rate limit is the bottleneck, not latency              # embed quota is per item; free tier allows 100/min
REPOSAGE_LOG_LEVEL=INFO
REPOSAGE_LOG_JSON=false

# --- GitHub integration (only needed for PR review) ------------------------
# A token with `pull_requests: write` scope. In Actions use ${{ secrets.GITHUB_TOKEN }}.
GITHUB_TOKEN=
